  "questionnaire": [
    {"key": "organization.legal_name", "label": "Legal company name", "help": "Used automatically in every policy and register.", "type": "text", "required": true},
    {"key": "organization.trading_name", "label": "Trading name", "help": "Leave blank if the same as the legal name.", "type": "text", "required": false},
    {"key": "organization.address", "label": "Main business address", "help": null, "type": "textarea", "required": true},
    {"key": "organization.services", "label": "Products and services", "help": "A short description is enough.", "type": "textarea", "required": true},
    {"key": "organization.locations", "label": "Business locations", "help": "Include remote-only operations where relevant.", "type": "textarea", "required": true},
    {"key": "organization.employee_count", "label": "Number of workers", "help": "Include employees and regular contractors.", "type": "number", "required": true},
    {"key": "roles.executive_owner", "label": "Executive owner", "help": "The senior person accountable for the management system.", "type": "text", "required": true},
    {"key": "roles.system_manager", "label": "Compliance or management-system manager", "help": "The person coordinating day-to-day work.", "type": "text", "required": true},
    {"key": "roles.security_owner", "label": "Information-security owner", "help": "Can be the same person as the system manager.", "type": "text", "required": false},
    {"key": "roles.privacy_owner", "label": "Privacy or data-protection owner", "help": null, "type": "text", "required": false},
    {"key": "roles.quality_owner", "label": "Quality owner", "help": null, "type": "text", "required": false},
    {"key": "roles.environment_owner", "label": "Environmental owner", "help": null, "type": "text", "required": false},
    {"key": "roles.ai_owner", "label": "AI governance owner", "help": null, "type": "text", "required": false},
    {"key": "organization.certification_target", "label": "Target certification or assessment date", "help": "CompPlus uses this to propose task deadlines.", "type": "date", "required": false},
    {"key": "organization.review_month", "label": "Preferred annual review month", "help": null, "type": "single_select", "required": true, "options": ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], "default": "January"},
    {"key": "organization.uses_suppliers", "label": "Do suppliers process data or deliver important services?", "help": null, "type": "boolean", "required": true, "default": true},
    {"key": "organization.uses_ai", "label": "Does the organisation develop or use AI systems?", "help": null, "type": "boolean", "required": true, "default": false},
    {"key": "organization.processes_personal_data", "label": "Does the organisation process personal data?", "help": null, "type": "boolean", "required": true, "default": true},
    {"key": "organization.environmental_impacts", "label": "Does the organisation have material environmental impacts?", "help": "Examples include energy, travel, waste, emissions, water or purchased goods.", "type": "boolean", "required": true, "default": true}
  ],
  "templates": [
    {
      "id": "management-system-scope",
      "name": "Management System Scope",
      "kind": "document",
      "purpose": "Define what parts of the organisation, services and locations are covered.",
      "owner_role": "system_manager",
      "review_frequency_months": 12,
      "user_effort": {"estimated_minutes": 10, "confirmations": 4, "evidence_requests": 0},
      "fields": [
        {"key": "organization.legal_name", "mode": "auto", "source": "questionnaire", "prompt": null},
        {"key": "organization.services", "mode": "auto", "source": "questionnaire", "prompt": null},
        {"key": "organization.locations", "mode": "auto", "source": "questionnaire", "prompt": null},
        {"key": "scope.exclusions", "mode": "confirm", "source": null, "prompt": "Confirm whether anything is outside scope and explain why."}
      ],
      "mappings": [
        {"framework": "ISO/IEC 27001", "reference": "4.3", "mapping_type": "direct"},
        {"framework": "ISO 9001", "reference": "4.3", "mapping_type": "direct"},
        {"framework": "ISO 14001", "reference": "4.3", "mapping_type": "direct"},
        {"framework": "ISO/IEC 42001", "reference": "4.3", "mapping_type": "direct"}
      ],
      "content_file": "documents/management-system-scope.md",
      "creates": ["document", "task"]
    },
