    {"objective": "Improve staff competence", "metric": "Required training completed", "baseline": "{{ metrics.training_completion_rate }}", "target": "100%", "owner": "{{ roles.system_manager }}", "due_date": "{{ objective.training_due_date | confirm }}", "review_frequency": "Monthly", "status": "Open", "evidence": "Training register and completion records"},
    {"objective": "Close corrective actions effectively", "metric": "Corrective actions closed by due date and verified", "baseline": "{{ metrics.corrective_action_rate }}", "target": "90% or higher", "owner": "{{ roles.system_manager }}", "due_date": "{{ objective.year_end | confirm }}", "review_frequency": "Monthly", "status": "Open", "evidence": "Corrective-action register"}
  ]
