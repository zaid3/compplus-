# syntax=docker/dockerfile:1.7

# Production runtime image for Coolify.
# The CPU/RAM-heavy Node + Go compilation happens in GitHub Actions using
# Dockerfile.compplus.source. Coolify only downloads the prebuilt runtime bundle.
FROM ubuntu:24.04

# Internal runtime asset names remain stable for deployment compatibility.
ARG COMPPLUS_RUNTIME_URL=https://github.com/zaid3/compplus-/releases/download/runtime-latest/compplus-linux-amd64.tar.gz
ARG COMPPLUS_RUNTIME_REVISION=2026-08-08-isopilot-v3

LABEL org.opencontainers.image.source="https://github.com/zaid3/compplus-"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="ISOPilot"
LABEL org.opencontainers.image.description="ISOPilot governance, risk and compliance platform"

RUN useradd -m probo \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

# These tiny source fingerprints intentionally bust the runtime-download cache
# whenever the ISOPilot overlay or pinned upstream build definition changes.
COPY Dockerfile.compplus.source /tmp/Dockerfile.compplus.source
COPY compplus/overlay/ /tmp/compplus-overlay-fingerprint/

# The runtime release can take a few minutes to finish after a main-branch push.
# Wait for it instead of failing Coolify immediately on a temporary GitHub 404.
RUN set -eux; \
    echo "Installing ISOPilot runtime ${COMPPLUS_RUNTIME_REVISION}"; \
    downloaded=0; \
    for attempt in $(seq 1 60); do \
      if curl -fL --connect-timeout 15 --max-time 180 "${COMPPLUS_RUNTIME_URL}" -o /tmp/compplus-runtime.tar.gz; then \
        downloaded=1; \
        break; \
      fi; \
      echo "Runtime not published yet (attempt ${attempt}/60); waiting 10 seconds..."; \
      rm -f /tmp/compplus-runtime.tar.gz; \
      sleep 10; \
    done; \
    test "$downloaded" = "1"; \
    tar -xzf /tmp/compplus-runtime.tar.gz -C /usr/local/bin; \
    rm -rf /tmp/compplus-runtime.tar.gz /tmp/Dockerfile.compplus.source /tmp/compplus-overlay-fingerprint; \
    chmod +x /usr/local/bin/probod /usr/local/bin/probod-bootstrap /usr/local/bin/entrypoint.sh; \
    setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/probod; \
    mkdir -p /etc/probod; \
    chown probo:probo /etc/probod

USER probo
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 CMD curl -fsS http://127.0.0.1:8080/ >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
