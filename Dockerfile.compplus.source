# syntax=docker/dockerfile:1.7

# ISOPilot full source build. GitHub Actions compiles the complete application;
# the production VPS downloads the resulting prebuilt runtime.
#
# Keep the Probo architecture intact and pin to a reviewed upstream commit so
# every ISOPilot release is reproducible. This 2026-08-07 pin includes Probo's
# latest membership/authentication hardening and npm dependency security fixes.
ARG PROBO_UPSTREAM_SHA=7d4b92c5ef1d77d0815f22749e01b8202d683d58

FROM debian:bookworm-slim AS source
ARG PROBO_UPSTREAM_SHA
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --filter=blob:none https://github.com/getprobo/probo.git . \
    && git checkout --detach "${PROBO_UPSTREAM_SHA}" \
    && test "$(git rev-parse HEAD)" = "${PROBO_UPSTREAM_SHA}" \
    && rm -rf .git

COPY compplus/overlay/ /src/

# Fast Start uses the upstream measure importer. The reviewed upstream commit
# still omits MeasureID when it upserts requested evidence; evidences.measure_id
# is mandatory, so an install can create its framework and then fail with an
# internal server error. Patch that field explicitly and keep framework lookup
# scoped to the selected organisation to prevent cross-organisation linking.
RUN sed -i '/ID:[[:space:]]*evidenceID,/a\                                MeasureID:          measure.ID,' pkg/probo/measure_service.go \
    && sed -i 's/framework.LoadByReferenceID(ctx, tx, scope, standard.Framework)/framework.LoadByOrganizationIDAndReferenceID(ctx, tx, scope, organization.ID, standard.Framework)/' pkg/probo/measure_service.go \
    && grep -q 'MeasureID:[[:space:]]*measure.ID' pkg/probo/measure_service.go \
    && grep -q 'LoadByOrganizationIDAndReferenceID' pkg/probo/measure_service.go

# ISO 14001:2026 explicitly elevates biodiversity alongside climate and resource
# efficiency. Make it a visible starter prompt in the aspects register.
RUN sed -i 's/"Water use where relevant", /"Water use where relevant", "Biodiversity, ecosystems, habitats and land-use impacts where relevant", /' compplus/templates/pack_iso14001.go \
    && grep -q 'Biodiversity, ecosystems, habitats and land-use impacts' compplus/templates/pack_iso14001.go

# Rebrand customer-facing strings while preserving upstream package/API names,
# database identifiers, original copyright notices and legacy COMPPLUS- IDs.
# Final customer-facing casing is always ISOPilot.
RUN find apps -type f -path '*/_locales/*.json' -exec sed -i 's/Probo/ISOPilot/g; s/Comp Plus+/ISOPilot/g; s/ISOpilot/ISOPilot/g' {} + \
    && find compplus -type f \( -name '*.go' -o -name '*.ts' -o -name '*.tsx' -o -name '*.json' -o -name '*.md' \) -exec sed -i 's/Comp Plus+/ISOPilot/g; s/ISOpilot/ISOPilot/g' {} + \
    && find pkg/probo pkg/server/api/console -type f \( -name '*.go' -o -name '*.graphql' \) -exec sed -i 's/Comp Plus+/ISOPilot/g; s/ISOpilot/ISOPilot/g' {} +

FROM node:24-bookworm AS frontend
WORKDIR /src
COPY --from=source /src/ ./
RUN npm ci
RUN contrib/merge-graphql-schema.sh \
      pkg/server/api/connect/v1/schema.graphql \
      pkg/server/api/connect/v1/graphql \
    && contrib/merge-graphql-schema.sh \
      pkg/server/api/console/v1/schema.graphql \
      pkg/server/api/console/v1/graphql \
    && contrib/merge-graphql-schema.sh \
      pkg/server/api/complianceportal/v1/schema.graphql \
      pkg/server/api/complianceportal/v1/graphql \
    && npm run relay
# Merge the ISOPilot theme-control labels into the console "app" i18next catalog
# before bundling so the localized theme toggle ships with every supported locale.
RUN node contrib/merge-isopilot-theme-i18n.mjs \
    && node -e "const c=require('./apps/console/src/_locales/en-US.json'); if(!c.theme||!c.theme.options||c.theme.options.system!=='System'){process.exit(1)}"
RUN npm -w @probo/emails run build \
    && npm -w @probo/console run build \
    && npm -w @probo/compliance-portal run build

FROM golang:1.26.5-bookworm AS backend
WORKDIR /src
COPY --from=source /src/ ./
COPY --from=frontend /src/apps/console/dist ./apps/console/dist
COPY --from=frontend /src/apps/compliance-portal/dist ./apps/compliance-portal/dist
COPY --from=frontend /src/packages/emails/dist ./packages/emails/dist
RUN go mod download
RUN make generate
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.env=prod -X main.version=isopilot-2026.08.08" \
      -o /out/probod ./cmd/probod
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=isopilot-2026.08.08" \
      -o /out/probod-bootstrap ./cmd/probod-bootstrap

FROM ubuntu:24.04
LABEL org.opencontainers.image.source="https://github.com/zaid3/compplus-"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="ISOPilot"
LABEL org.opencontainers.image.description="ISOPilot governance, risk and compliance platform"
RUN useradd -m probo \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
COPY --from=backend /out/probod /usr/local/bin/probod
COPY --from=backend /out/probod-bootstrap /usr/local/bin/probod-bootstrap
COPY --from=source /src/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/probod /usr/local/bin/probod-bootstrap /usr/local/bin/entrypoint.sh \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/probod \
    && mkdir -p /etc/probod \
    && chown probo:probo /etc/probod
USER probo
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 CMD curl -fsS http://127.0.0.1:8080/ >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
