# syntax=docker/dockerfile:1.7

# Comp Plus+ full source build. This file is intentionally used by GitHub Actions,
# not by the production VPS. Production downloads the prebuilt runtime produced
# from this exact source build.
ARG PROBO_UPSTREAM_SHA=82221746eb9ca76942367e6c8a45013bb9895ec7

FROM debian:bookworm-slim AS source
ARG PROBO_UPSTREAM_SHA
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --filter=blob:none https://github.com/getprobo/probo.git . \
    && git checkout --detach "${PROBO_UPSTREAM_SHA}" \
    && test "$(git rev-parse HEAD)" = "${PROBO_UPSTREAM_SHA}" \
    && rm -rf .git

COPY compplus/overlay/ /src/

# Comp Plus+ fixes two upstream v0.253.0 import edge cases used by Fast Start:
# 1) requested evidence created by MeasureService.Import must carry its measure_id;
# 2) framework references must resolve inside the selected organization, not just
#    the tenant, so multiple charities can install the same framework safely.
RUN sed -i '/ID:[[:space:]]*evidenceID,/a\                                MeasureID:          measure.ID,' pkg/probo/measure_service.go \
    && sed -i 's/framework.LoadByReferenceID(ctx, tx, scope, standard.Framework)/framework.LoadByOrganizationIDAndReferenceID(ctx, tx, scope, organization.ID, standard.Framework)/' pkg/probo/measure_service.go \
    && grep -q 'MeasureID:[[:space:]]*measure.ID' pkg/probo/measure_service.go \
    && grep -q 'LoadByOrganizationIDAndReferenceID' pkg/probo/measure_service.go

RUN find apps -type f -path '*/_locales/*.json' -exec sed -i 's/Probo/Comp Plus+/g' {} +

FROM node:24-bookworm AS frontend
WORKDIR /src
COPY --from=source /src/ ./
RUN npm ci
RUN contrib/merge-graphql-schema.sh \
      pkg/server/api/connect/v1/schema.graphql \
      pkg/server/api/connect/v1/graphql \
    && contrib/merge-graphql-schema.sh \
      pkg/server/api/console/v1/schema.graphql \
      pkg/server/api/console/v1/graphql \
    && contrib/merge-graphql-schema.sh \
      pkg/server/api/complianceportal/v1/schema.graphql \
      pkg/server/api/complianceportal/v1/graphql \
    && npm run relay
RUN npm -w @probo/emails run build \
    && npm -w @probo/console run build \
    && npm -w @probo/compliance-portal run build

FROM golang:1.26.5-bookworm AS backend
WORKDIR /src
COPY --from=source /src/ ./
COPY --from=frontend /src/apps/console/dist ./apps/console/dist
COPY --from=frontend /src/apps/compliance-portal/dist ./apps/compliance-portal/dist
COPY --from=frontend /src/packages/emails/dist ./packages/emails/dist
RUN go mod download
RUN make generate
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.env=prod -X main.version=comp-plus-2026.08-final" \
      -o /out/probod ./cmd/probod
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=comp-plus-2026.08-final" \
      -o /out/probod-bootstrap ./cmd/probod-bootstrap

FROM ubuntu:24.04
LABEL org.opencontainers.image.source="https://github.com/zaid3/compplus-"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="Comp Plus+"
LABEL org.opencontainers.image.description="Comp Plus+ governance, risk and compliance platform"
RUN useradd -m probo \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
COPY --from=backend /out/probod /usr/local/bin/probod
COPY --from=backend /out/probod-bootstrap /usr/local/bin/probod-bootstrap
COPY --from=source /src/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/probod /usr/local/bin/probod-bootstrap /usr/local/bin/entrypoint.sh \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/probod \
    && mkdir -p /etc/probod \
    && chown probo:probo /etc/probod
USER probo
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
