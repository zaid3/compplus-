# Copy these keys into Coolify's Environment Variables screen.
# Do not commit real secret values.

# Replace with your actual HTTPS domain after assigning it in Coolify.
PROBOD_BASE_URL=https://compliance.example.com
API_CORS_ALLOWED_ORIGINS=https://compliance.example.com
AUTH_COOKIE_DOMAIN=compliance.example.com

# Generate a different value for every secret:
# openssl rand -base64 32
PROBOD_ENCRYPTION_KEY=CHANGE_ME
AUTH_COOKIE_SECRET=CHANGE_ME
AUTH_PASSWORD_PEPPER=CHANGE_ME
TRUST_AUTH_TOKEN_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Keep sign-up open for the initial administrator account.
# Change to true after the first account has been created.
AUTH_DISABLE_SIGNUP=false

# Optional SMTP settings
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REQUIRED=true
MAILER_SENDER_NAME=CompPlus
MAILER_SENDER_EMAIL=no-reply@example.com

# Optional AI features in this imported version
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
OPENAI_TEMPERATURE=0.1
